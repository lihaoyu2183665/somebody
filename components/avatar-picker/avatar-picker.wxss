.ap-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    background: rgba(60, 88, 110, 0.42);
}

.ap-sheet {
    width: 100%;
    padding: 36rpx 32rpx 48rpx;
    background: #F7FBFD;
    border-radius: 32rpx 32rpx 0 0;
    box-sizing: border-box;
}

.ap-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.ap-title {
    font-size: 32rpx;
    font-weight: 700;
    color: #31475C;
}

.ap-close {
    padding: 6rpx 12rpx;
    font-size: 25rpx;
    color: #6A8298;
}

.ap-hint {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #6A8298;
}

.ap-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: 22rpx;
}

.ap-item {
    width: 20%;
    display: flex;
    justify-content: center;
    padding: 10rpx 0;
    box-sizing: border-box;
}

.ap-img {
    width: 104rpx;
    height: 104rpx;
    border-radius: 50%;
    border: 4rpx solid transparent;
    box-sizing: border-box;
    background: #DCEBF7;
}

.ap-item-on .ap-img {
    border-color: #3D78A8;
}

.ap-actions {
    display: flex;
    flex-wrap: wrap;
    margin-top: 26rpx;
}

.ap-btn {
    flex: 1;
    min-width: 240rpx;
    height: 76rpx;
    line-height: 76rpx;
    margin: 0 8rpx;
    padding: 0 18rpx;
    border: none;
    border-radius: 18rpx;
    font-size: 26rpx;
    font-weight: 600;
    text-align: center;
    box-sizing: border-box;
}

.ap-btn::after {
    border: none;
}

.ap-btn-primary {
    background: #3D78A8;
    color: #FFFFFF;
}

.ap-btn-plain {
    background: #F7FBFD;
    color: #668098;
    border: 2rpx solid #CEE0ED;
}
