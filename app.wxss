/* 雪域俱乐部 · 护眼淡蓝主题 / 低饱和柔和蓝 / 无纯白卡片与近黑文字 */
page {
    background: #E9F3FA;
    color: #31475C;
    font-size: 28rpx;
    line-height: 1.6;
}

.page {
    min-height: 100vh;
    padding: 0 28rpx 180rpx;
    box-sizing: border-box;
}

.page-no-tab {
    padding-bottom: 60rpx;
}

/* 雪狸品牌标识 */
.brand-bar {
    display: flex;
    align-items: center;
    margin-top: 24rpx;
    padding: 20rpx 26rpx;
    background: #F7FBFD;
    border-radius: 26rpx;
    box-shadow: 0 8rpx 26rpx rgba(60, 88, 110, 0.05);
}

.brand-bar-mark {
    width: 88rpx;
    height: 88rpx;
    flex: none;
    margin-right: 22rpx;
}

.brand-bar-text {
    display: flex;
    flex-direction: column;
}

.brand-bar-name {
    font-size: 28rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
    color: #31475C;
}

.brand-bar-slogan {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #7892A8;
}

.brand-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 44rpx 0 20rpx;
}

.brand-footer-mark {
    width: 40rpx;
    height: 40rpx;
    margin-right: 12rpx;
    opacity: 0.85;
}

.brand-footer text {
    font-size: 22rpx;
    letter-spacing: 1rpx;
    color: #ABC1D2;
}

/* 顶部横幅 */
.hero {
    position: relative;
    margin: 24rpx 0 32rpx;
    padding: 40rpx 36rpx 36rpx;
    min-height: 190rpx;
    border-radius: 30rpx;
    background: #DCEBF7;
    overflow: hidden;
    box-sizing: border-box;
}

.hero-plain {
    background: #F7FBFD;
}

/* 模块照片横幅：照片铺底，淡蓝渐变遮罩保证标题可读，与护眼淡蓝主题统一 */
.hero-photo {
    min-height: 268rpx;
    padding-bottom: 42rpx;
}

.hero-photo-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0.95;
}

.hero-photo-mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(233, 243, 250, 0.96) 0%, rgba(233, 243, 250, 0.88) 38%, rgba(233, 243, 250, 0.40) 72%, rgba(233, 243, 250, 0.10) 100%);
}

.hero-photo .hero-kicker,
.hero-photo .hero-title,
.hero-photo .hero-sub {
    z-index: 1;
    text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.45);
}

.hero-kicker {
    position: relative;
    display: block;
    font-size: 22rpx;
    letter-spacing: 4rpx;
    color: #3D78A8;
}

.hero-title {
    position: relative;
    display: block;
    margin-top: 10rpx;
    font-size: 42rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
    color: #31475C;
}

.hero-sub {
    position: relative;
    display: block;
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #6A8298;
}

/* 区块标题 */
.section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 36rpx 4rpx 18rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #31475C;
}

.section-more {
    font-size: 24rpx;
    color: #3D78A8;
}

.section-mark {
    display: inline-block;
    width: 8rpx;
    height: 28rpx;
    margin-right: 14rpx;
    border-radius: 6rpx;
    background: #3D78A8;
    vertical-align: -4rpx;
}

/* 卡片 */
.card {
    margin-bottom: 22rpx;
    padding: 30rpx;
    background: #F7FBFD;
    border-radius: 26rpx;
    box-shadow: 0 6rpx 24rpx rgba(60, 88, 110, 0.045);
    box-sizing: border-box;
}

.card-flat {
    box-shadow: none;
    border: 2rpx solid #DCEAF5;
}

.card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.card-title {
    flex: 1;
    font-size: 32rpx;
    font-weight: 700;
    line-height: 1.45;
    color: #31475C;
}

.card-desc {
    display: block;
    margin-top: 10rpx;
    font-size: 25rpx;
    color: #6A8298;
    line-height: 1.6;
}

.card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24rpx;
    padding-top: 20rpx;
    border-top: 2rpx solid #E3F0F9;
}

.card-actions {
    display: flex;
    align-items: center;
}

/* 信息行 */
.info-row {
    display: flex;
    align-items: flex-start;
    margin-top: 14rpx;
}

.info-label {
    width: 132rpx;
    flex-shrink: 0;
    font-size: 25rpx;
    color: #8FA8BC;
}

.info-value {
    flex: 1;
    font-size: 26rpx;
    color: #40566B;
    word-break: break-all;
}

.info-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: 18rpx;
}

.info-cell {
    width: 50%;
    margin-bottom: 14rpx;
    box-sizing: border-box;
    padding-right: 16rpx;
}

.info-cell-label {
    display: block;
    font-size: 22rpx;
    color: #8FA8BC;
}

.info-cell-value {
    display: block;
    margin-top: 4rpx;
    font-size: 27rpx;
    color: #40566B;
}

/* 标签 */
.chip {
    display: inline-block;
    padding: 6rpx 18rpx;
    margin-right: 12rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    color: #3D78A8;
    background: #DCEBF7;
}

.chip-muted {
    color: #7E96AB;
    background: #E3F0F9;
}

.chip-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 16rpx;
}

.tag-official {
    display: inline-block;
    padding: 5rpx 14rpx;
    border-radius: 8rpx;
    font-size: 21rpx;
    color: #FFFFFF;
    background: #3D78A8;
}

/* 筛选条 */
.filters {
    display: flex;
    align-items: center;
    padding: 6rpx 0 8rpx;
}

.filter-item {
    flex-shrink: 0;
    padding: 12rpx 28rpx;
    margin-right: 16rpx;
    border-radius: 999rpx;
    font-size: 25rpx;
    color: #6A8298;
    background: #F7FBFD;
}

.filter-on {
    color: #FFFFFF;
    background: #3D78A8;
}

/* 按钮 */
.btn {
    display: block;
    width: 100%;
    height: 92rpx;
    line-height: 92rpx;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 20rpx;
    font-size: 30rpx;
    font-weight: 600;
    text-align: center;
    box-sizing: border-box;
}

.btn::after {
    border: none;
}

.btn-primary {
    color: #FFFFFF;
    background: #3D78A8;
}

.btn-ghost {
    color: #3D78A8;
    background: #DCEBF7;
}

.btn-neutral {
    color: #668098;
    background: #E3F0F9;
}

.btn-plain {
    color: #668098;
    background: #F7FBFD;
    border: 2rpx solid #CEE0ED;
}

.btn-danger {
    color: #9B5B4C;
    background: #F8EFEB;
}

.btn-sm {
    display: inline-block;
    width: auto;
    height: 60rpx;
    line-height: 60rpx;
    padding: 0 26rpx;
    margin-left: 14rpx;
    font-size: 24rpx;
    font-weight: 500;
    border-radius: 14rpx;
}

.btn-row {
    display: flex;
    align-items: center;
    margin-top: 26rpx;
}

.btn-row > .btn {
    flex: 1;
    margin-right: 18rpx;
}

.btn-row > .btn:last-child {
    margin-right: 0;
}

.btn-disabled {
    opacity: 0.55;
}

.fab {
    position: fixed;
    right: 36rpx;
    bottom: 60rpx;
    z-index: 20;
    display: flex;
    align-items: center;
    height: 88rpx;
    padding: 0 34rpx;
    border-radius: 999rpx;
    color: #FFFFFF;
    background: #3D78A8;
    box-shadow: 0 10rpx 30rpx rgba(61, 120, 168, 0.24);
    font-size: 28rpx;
    font-weight: 600;
}

.fab-plus {
    margin-right: 12rpx;
    font-size: 36rpx;
    font-weight: 300;
    line-height: 1;
}

.footer-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
    background: #F7FBFD;
    border-top: 2rpx solid #DCEAF5;
}

/* 表单 */
.form-card {
    margin-bottom: 24rpx;
    padding: 8rpx 30rpx 24rpx;
    background: #F7FBFD;
    border-radius: 26rpx;
    box-shadow: 0 6rpx 24rpx rgba(60, 88, 110, 0.045);
}

.form-title {
    display: block;
    padding: 26rpx 0 8rpx;
    font-size: 26rpx;
    font-weight: 700;
    color: #3D78A8;
}

.form-item {
    padding: 20rpx 0;
    border-bottom: 2rpx solid #E3F0F9;
}

.form-item:last-child {
    border-bottom: none;
}

.form-label {
    display: block;
    margin-bottom: 12rpx;
    font-size: 25rpx;
    color: #6A8298;
}

.form-required {
    color: #3D78A8;
}

.form-input,
.form-textarea,
.form-picker {
    width: 100%;
    padding: 16rpx 20rpx;
    min-height: 56rpx;
    font-size: 28rpx;
    color: #31475C;
    background: #F2F8FC;
    border-radius: 16rpx;
    box-sizing: border-box;
}

.form-textarea {
    height: 170rpx;
}

.form-picker {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.form-placeholder {
    color: #B4C8D8;
}

.form-hint {
    display: block;
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #A6BDCE;
}

/* 提交审核前的必填信息清单 */
.check-list {
    display: flex;
    flex-wrap: wrap;
    margin-top: 12rpx;
}

.check-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: calc(50% - 8rpx);
    margin: 0 16rpx 12rpx 0;
    padding: 12rpx 16rpx;
    background: #F2F8FC;
    border-radius: 14rpx;
    box-sizing: border-box;
}

.check-item:nth-child(2n) {
    margin-right: 0;
}

.check-label {
    font-size: 24rpx;
    color: #58738C;
}

.check-state {
    font-size: 22rpx;
    color: #A0724A;
}

.check-done {
    color: #3D78A8;
    font-weight: 600;
}

.save-hint {
    margin: 18rpx 6rpx 0;
    text-align: center;
}

.form-error {
    display: block;
    margin: 16rpx 0;
    padding: 18rpx 22rpx;
    font-size: 25rpx;
    color: #9B5B4C;
    background: #F8EFEB;
    border-radius: 14rpx;
}

.form-line {
    display: flex;
    align-items: center;
}

.form-line > .form-item {
    flex: 1;
}

.form-line > .form-item:first-child {
    margin-right: 20rpx;
}

/* 图片 */
.image-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: 14rpx;
}

.image-box {
    position: relative;
    width: 160rpx;
    height: 160rpx;
    margin: 0 16rpx 16rpx 0;
    border-radius: 18rpx;
    overflow: hidden;
    background: #E3F0F9;
}

.image-box image {
    width: 100%;
    height: 100%;
}

.image-del {
    position: absolute;
    top: 0;
    right: 0;
    width: 44rpx;
    height: 44rpx;
    line-height: 40rpx;
    text-align: center;
    color: #FFFFFF;
    background: rgba(60, 88, 110, 0.62);
    border-bottom-left-radius: 16rpx;
    font-size: 28rpx;
}

.image-add {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 160rpx;
    height: 160rpx;
    margin-bottom: 16rpx;
    border: 2rpx dashed #C3D9E9;
    border-radius: 18rpx;
    color: #86A0B5;
    font-size: 22rpx;
    box-sizing: border-box;
}

.image-add-plus {
    font-size: 48rpx;
    font-weight: 300;
    line-height: 1.1;
}

.detail-image {
    width: 100%;
    height: 420rpx;
    border-radius: 26rpx;
    margin-bottom: 24rpx;
    background: #E3F0F9;
}

/* 价格 */
.price {
    font-size: 34rpx;
    font-weight: 700;
    color: #3D78A8;
}

.price-small {
    font-size: 26rpx;
    font-weight: 700;
    color: #3D78A8;
}

.price-unit {
    font-size: 22rpx;
    font-weight: 400;
    color: #8FA8BC;
}

/* 头像 */
.avatar {
    width: 88rpx;
    height: 88rpx;
    flex-shrink: 0;
    border-radius: 50%;
    background: #DCEBF7;
    color: #3D78A8;
    font-size: 34rpx;
    font-weight: 600;
    text-align: center;
    line-height: 88rpx;
    overflow: hidden;
}

.avatar-lg {
    width: 128rpx;
    height: 128rpx;
    line-height: 128rpx;
    font-size: 48rpx;
}

/* 三态 */
.state {
    padding: 90rpx 40rpx;
    text-align: center;
    color: #8FA8BC;
    font-size: 26rpx;
}

.state-title {
    display: block;
    margin-bottom: 12rpx;
    font-size: 28rpx;
    color: #6A8298;
}

.state-action {
    display: inline-block;
    margin-top: 24rpx;
    padding: 12rpx 36rpx;
    border-radius: 999rpx;
    color: #3D78A8;
    background: #DCEBF7;
    font-size: 25rpx;
}

/* 我的页面 */
.profile-card {
    display: flex;
    align-items: center;
    padding: 40rpx 32rpx;
    margin: 24rpx 0 30rpx;
    background: #F7FBFD;
    border-radius: 28rpx;
    box-shadow: 0 6rpx 24rpx rgba(60, 88, 110, 0.045);
}

.profile-info {
    flex: 1;
    margin-left: 26rpx;
}

.profile-name {
    display: block;
    font-size: 34rpx;
    font-weight: 700;
}

.profile-sub {
    display: block;
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #8FA8BC;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 30rpx 8rpx;
    border-bottom: 2rpx solid #E3F0F9;
}

.menu-item:last-child {
    border-bottom: none;
}

.menu-label {
    flex: 1;
    font-size: 28rpx;
    color: #40566B;
}

.menu-arrow {
    font-size: 34rpx;
    color: #BAD0E0;
    line-height: 1;
}

.stat-row {
    display: flex;
    padding: 24rpx 0 8rpx;
}

.stat-cell {
    flex: 1;
    text-align: center;
}

.stat-num {
    display: block;
    font-size: 36rpx;
    font-weight: 700;
    color: #3D78A8;
}

.stat-label {
    display: block;
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #8FA8BC;
}

/* 登录 */
.login-wrap {
    padding: 60rpx 40rpx;
}

.login-logo {
    width: 230rpx;
    height: 330rpx;
    margin: 30rpx auto 20rpx;
}

.login-logo image {
    width: 100%;
    height: 100%;
}

.login-title {
    display: block;
    text-align: center;
    font-size: 42rpx;
    font-weight: 700;
}

.login-sub {
    display: block;
    margin: 12rpx 0 60rpx;
    text-align: center;
    font-size: 25rpx;
    color: #7892A8;
}

.login-tip-text {
    display: block;
    margin-top: 30rpx;
    text-align: center;
    font-size: 22rpx;
    color: #A6BDCE;
    line-height: 1.7;
}

/* 通用 */
.row {
    display: flex;
    align-items: center;
}

.between {
    justify-content: space-between;
}

.muted {
    color: #8FA8BC;
    font-size: 24rpx;
}

.small {
    font-size: 23rpx;
}

.strong {
    font-weight: 700;
}

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.green { color: #3D78A8; }

.divider {
    height: 2rpx;
    margin: 24rpx 0;
    background: #E3F0F9;
}

.option-item {
    display: flex;
    align-items: center;
    padding: 24rpx;
    margin-bottom: 16rpx;
    border-radius: 20rpx;
    border: 2rpx solid #DCEAF5;
    background: #F7FBFD;
}

.option-on {
    border-color: #3D78A8;
    background: #E8F3FB;
}

.option-main {
    flex: 1;
}

.option-name {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
}

.option-note {
    display: block;
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #8FA8BC;
}

.option-dot {
    width: 34rpx;
    height: 34rpx;
    margin-right: 20rpx;
    border-radius: 50%;
    border: 3rpx solid #C3D9E9;
    box-sizing: border-box;
}

.option-dot-on {
    border: 10rpx solid #3D78A8;
}

.ico {
    width: 30rpx;
    height: 30rpx;
    margin-right: 12rpx;
    opacity: 0.75;
}

/* 雪具市场 */
.gear-cover {
    width: 168rpx;
    height: 168rpx;
    flex-shrink: 0;
    border-radius: 18rpx;
    background: #E3F0F9;
}

.gear-cover-empty {
    display: flex;
    align-items: center;
    justify-content: center;
}

.cover-ico {
    width: 64rpx;
    height: 64rpx;
    opacity: 0.45;
}

.gear-main {
    flex: 1;
    min-width: 0;
    margin-left: 24rpx;
}

.gear-title {
    display: block;
    font-size: 30rpx;
    font-weight: 700;
    line-height: 1.4;
}

.gear-sub {
    display: block;
    margin-top: 8rpx;
    font-size: 23rpx;
    color: #8FA8BC;
}

.scroll-filters {
    width: 100%;
    white-space: nowrap;
}

.coach-card-head {
    display: flex;
    align-items: center;
}

.coach-avatar-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.avatar-edit-hint {
    display: block;
    margin-top: 10rpx;
    font-size: 21rpx;
    color: #6A8298;
}

.coach-avatar-row {
    display: flex;
    align-items: center;
    padding: 6rpx 0 28rpx;
}

.coach-avatar-info {
    flex: 1;
    margin-left: 28rpx;
    min-width: 0;
}

.coach-info {
    flex: 1;
    margin-left: 24rpx;
    min-width: 0;
}

.slot-row {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 2rpx solid #E3F0F9;
}

.slot-row:last-child {
    border-bottom: none;
}

.slot-main {
    flex: 1;
}

.slot-time {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #40566B;
}

.slot-note {
    display: block;
    margin-top: 4rpx;
    font-size: 23rpx;
    color: #8FA8BC;
}


.review-tip {
    margin-bottom: 22rpx;
    padding: 20rpx 24rpx;
    border-radius: 18rpx;
    background: #DCEBF7;
    color: #356A94;
    font-size: 24rpx;
    line-height: 1.6;
}

.notice-card {
    background: #E8F3FB;
    border: 1rpx solid #CEE2F0;
    margin-bottom: 8rpx;
}

.notice-card .card-desc {
    margin-top: 12rpx;
}

.check-item-title {
    flex: 1;
    font-size: 27rpx;
    color: #374D62;
}

.chip-warn {
    color: #8A6A3C;
    background: #F5EEE0;
}

.chip-ok {
    color: #356A94;
    background: #DCEBF7;
}

.gate-badge {
    min-width: 36rpx;
    height: 36rpx;
    line-height: 36rpx;
    padding: 0 10rpx;
    border-radius: 18rpx;
    background: #3D78A8;
    color: #FFFFFF;
    font-size: 22rpx;
    text-align: center;
}

/* 审核中心：多筛选项换行、会员注册资料展开区 */
.filters-wrap {
    flex-wrap: wrap;
    row-gap: 10rpx;
}

.btn-row-wrap {
    flex-wrap: wrap;
    row-gap: 10rpx;
}

.member-detail {
    margin-top: 24rpx;
    padding: 24rpx 26rpx;
    border-radius: 20rpx;
    background: #E3F0F9;
}

.detail-title {
    display: block;
    margin-bottom: 12rpx;
    font-size: 25rpx;
    font-weight: 600;
    color: #374D62;
}

.detail-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 9rpx 0;
    font-size: 25rpx;
}

.detail-key {
    flex-shrink: 0;
    color: #6A8298;
}

.detail-value {
    max-width: 66%;
    color: #374D62;
    text-align: right;
    word-break: break-all;
}

/* 报名人员 / 拼团人：姓名可点，详情用弹层展示，不再在列表里直接展开 */
.person-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 0;
    border-bottom: 2rpx solid #E3EEF7;
}

.person-row:last-child {
    border-bottom: none;
}

.person-row-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.person-name {
    align-self: flex-start;
    color: #3D78A8;
    font-size: 30rpx;
    font-weight: 600;
    border-bottom: 2rpx solid #9CC3DE;
    padding-bottom: 2rpx;
}

.person-row-sub {
    margin-top: 8rpx;
    font-size: 23rpx;
    color: #6A8298;
}

.person-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 80;
    background: rgba(24, 45, 62, 0.45);
}

.person-panel {
    position: fixed;
    left: 40rpx;
    right: 40rpx;
    top: 50%;
    transform: translateY(-50%);
    z-index: 81;
    max-height: 72vh;
    overflow-y: auto;
    padding: 32rpx 30rpx;
    border-radius: 28rpx;
    background: #F7FBFD;
    box-shadow: 0 18rpx 50rpx rgba(60, 88, 110, 0.20);
}

.person-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.person-panel-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #31475C;
}

.person-panel-close {
    padding: 0 10rpx;
    font-size: 30rpx;
    color: #6A8298;
}

.person-panel-hint {
    display: block;
    margin: 12rpx 0 18rpx;
    font-size: 23rpx;
    color: #6A8298;
}

.person-panel-body {
    padding: 18rpx 22rpx;
    border-radius: 20rpx;
    background: #E9F3FA;
}

.person-panel .btn {
    width: 100%;
    margin-top: 26rpx;
}

/* 权限配色：管理员红 / 教练蓝 / 正式用户黑 / 普通会员灰 */
.tone-admin { color: #B23A32; }
.tone-coach { color: #2F6FB0; }
.tone-formal { color: #374D62; }
.tone-guest { color: #8FA8BC; }
.role-name { font-weight: 600; }
.stat-cell-hover { opacity: 0.55; }

/* 头像：卡通插画与上传照片 */
.avatar-photo {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
}
.avatar-current {
    display: flex;
    align-items: center;
    padding: 10rpx 0 6rpx;
}
.avatar-current-info {
    flex: 1;
    margin-left: 28rpx;
}
.avatar-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: 12rpx;
}
.avatar-option {
    width: 25%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14rpx 0;
    border: 2rpx solid transparent;
    border-radius: 18rpx;
    box-sizing: border-box;
}
.avatar-option-on {
    border-color: #3D78A8;
    background: #EAF4FB;
}
.user-row {
    display: flex;
    align-items: center;
}
.user-row-info {
    flex: 1;
    margin-left: 24rpx;
}
