<view class="page">
    <view wx:if="{{loading}}" class="state">正在加载会员信息…</view>

    <view wx:else>
        <view class="profile-card" wx:if="{{signedIn}}">
            <view class="avatar avatar-lg {{avatarClass}}" bindtap="onEditMember">
                <image wx:if="{{avatarPhotoUrl}}" class="avatar-photo" src="{{avatarPhotoUrl}}" mode="aspectFill" />
                <text wx:else>{{avatarGlyph}}</text>
            </view>
            <view class="profile-info">
                <text class="profile-name">{{displayName}}</text>
                <text class="profile-sub"><text class="role-name" style="color:{{roleColor}}">{{roleText}}</text> · {{levelText}}</text>
            </view>
        </view>
        <view class="profile-card" wx:else>
            <view class="avatar avatar-lg">雪</view>
            <view class="profile-info">
                <text class="profile-name">未登录</text>
                <text class="profile-sub">所有模块已开放浏览 · 注册并审核通过后可查看详情</text>
            </view>
        </view>

        <button wx:if="{{!signedIn}}" class="btn btn-primary" bindtap="onLogin">登录 / 注册</button>

        <view class="card" wx:if="{{canView}}">
            <view class="stat-row">
                <view class="stat-cell" hover-class="stat-cell-hover" data-tab="posts" bindtap="onStat">
                    <text class="stat-num">{{stats.posts}}</text>
                    <text class="stat-label">我的发布 ›</text>
                </view>
                <view class="stat-cell" hover-class="stat-cell-hover" data-tab="signups" bindtap="onStat">
                    <text class="stat-num">{{stats.signups}}</text>
                    <text class="stat-label">拼车报名 ›</text>
                </view>
                <view class="stat-cell" hover-class="stat-cell-hover" data-tab="orders" bindtap="onStat">
                    <text class="stat-num">{{stats.orders}}</text>
                    <text class="stat-label">参团订单 ›</text>
                </view>
                <view class="stat-cell" hover-class="stat-cell-hover" data-tab="bookings" bindtap="onStat">
                    <text class="stat-num">{{stats.bookings}}</text>
                    <text class="stat-label">约课预约 ›</text>
                </view>
            </view>
            <text class="card-desc">点击上方数字可快速查看自己发布过的内容与全部报名、订单、预约记录。</text>
        </view>

        <view class="card">
            <block wx:if="{{canView}}">
                <view class="menu-item" bindtap="onRecords">
                    <text class="menu-label">我的记录</text>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" bindtap="onCoach">
                    <text class="menu-label">{{canCoach ? '教练主页与排课' : '申请成为认证教练'}}</text>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" wx:if="{{isAdmin}}" bindtap="onMembers">
                    <text class="menu-label">用户管理 · 全部用户信息</text>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" wx:if="{{isAdmin}}" bindtap="onAdmin">
                    <text class="menu-label">审核中心</text>
                    <text class="menu-arrow">›</text>
                </view>
                <view class="menu-item" wx:if="{{isAdmin}}" bindtap="onPayment">
                    <text class="menu-label">收款与支付接入</text>
                    <text class="menu-arrow">›</text>
                </view>
            </block>
            <view class="menu-item" wx:if="{{signedIn}}" bindtap="onLogout">
                <text class="menu-label">退出登录</text>
                <text class="menu-arrow">›</text>
            </view>
        </view>

        <view class="card" wx:if="{{isCoach}}">
            <text class="section-title"><text class="section-mark"></text>认证教练</text>
            <text class="card-desc">你已获教练权限，可在「教练主页与排课」发布教练资料、安排可约时段，并在教练详情页查看学员预约。教练资料与时段提交后仍需管理员审核通过才会对外展示；教练身份由管理员在审核中心授予或撤销。</text>
        </view>

        <view class="brand-footer">
            <image class="brand-footer-mark" src="/assets/brand-mark.png" mode="aspectFit" />
            <text>雪狸滑雪俱乐部 · ARCTIC CIVET</text>
        </view>
    </view>
</view>
