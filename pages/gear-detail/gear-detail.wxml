<view class="page">
    <access-gate wx:if="{{gate}}" gate="{{gate}}" bind:refresh="onRefresh" />
    <block wx:else>
    <view wx:if="{{loading}}" class="state">正在加载云端数据…</view>
    <view wx:elif="{{error}}" class="state">
        <text class="state-title">加载失败</text>
        <text>{{error}}</text>
        <view class="state-action" bindtap="load">重新加载</view>
    </view>

    <view wx:else>
        <swiper wx:if="{{images.length > 0}}" class="detail-image" indicator-dots="{{images.length > 1}}" indicator-color="#CEE0ED" indicator-active-color="#3D78A8">
            <swiper-item wx:for="{{images}}" wx:key="*this">
                <image src="{{item}}" style="width:100%;height:100%;border-radius:26rpx;" mode="aspectFill" />
            </swiper-item>
        </swiper>
        <view wx:else class="detail-image gear-cover-empty" style="display:flex;align-items:center;justify-content:center;">
            <image class="cover-ico" src="/assets/ico-tag.png" mode="aspectFit" />
        </view>

        <view class="card">
            <view class="card-head">
                <text class="card-title">{{gear.title}}</text>
                <text class="tag-official" wx:if="{{gear.isOnSale}}">在售</text>
                <text class="chip chip-muted" wx:else>{{gear.statusText}}</text>
            </view>
            <view class="chip-row">
                <text class="chip">{{gear.conditionText}}</text>
                <text class="chip chip-muted">{{gear.category}}</text>
            </view>
            <view class="divider"></view>
            <view class="row between">
                <text class="price">¥{{gear.priceText}}</text>
                <text class="muted" wx:if="{{gear.originalText}}">原价 ¥{{gear.originalText}}</text>
            </view>
            <view class="info-row">
                <text class="info-label">交易地点</text>
                <text class="info-value">{{gear.tradePlaceText}}</text>
            </view>
            <view class="info-row">
                <text class="info-label">联系方式</text>
                <text class="info-value">{{gear.contactText}}</text>
            </view>
            <view class="info-row">
                <text class="info-label">发布者</text>
                <text class="info-value">{{gear.ownerText}}</text>
            </view>
            <view class="divider"></view>
            <text class="form-label">装备描述</text>
            <text class="info-value">{{gear.descriptionText}}</text>
        </view>

        <block wx:if="{{canManage}}">
            <view class="section">
                <text class="section-title"><text class="section-mark"></text>管理这件装备</text>
            </view>
            <view class="card">
                <text class="card-desc">可修改描述与图片、切换售出状态或下架删除。</text>
                <view class="btn-row">
                    <button class="btn btn-ghost" bindtap="onEdit">编辑</button>
                    <button class="btn btn-plain" bindtap="onToggleSold">{{gear.isOnSale ? '标记售出' : '重新上架'}}</button>
                </view>
                <view class="mt-16">
                    <button class="btn btn-danger" bindtap="onDelete">删除装备</button>
                </view>
            </view>
        </block>
    </view>

    <view class="footer-bar" wx:if="{{!loading && !error && !canManage}}">
        <button class="btn btn-primary" bindtap="onCopyContact">复制卖家联系方式</button>
    </view>
    </block>
</view>
