<view class="page">
    <access-gate wx:if="{{gate}}" gate="{{gate}}" bind:refresh="onRefresh" />
    <block wx:else>
    <view wx:if="{{loading}}" class="state">正在加载云端数据…</view>
    <view wx:elif="{{error}}" class="state">
        <text class="state-title">加载失败</text>
        <text>{{error}}</text>
        <view class="state-action" bindtap="load">重新加载</view>
    </view>

    <view wx:else>
        <view class="card">
            <view class="card-head">
                <text class="card-title">{{trip.title}}</text>
                <text class="tag-official" wx:if="{{trip.isOpen}}">报名中</text>
                <text class="chip chip-muted" wx:else>{{trip.statusText}}</text>
            </view>
            <view class="chip-row">
                <text class="tag-official" wx:if="{{trip.is_official}}">俱乐部官方</text>
                <text class="chip" wx:else>俱乐部活动</text>
                <text class="chip chip-muted">限 {{trip.capacity}} 人</text>
            </view>
            <view class="divider"></view>
            <view class="info-row">
                <image class="ico" src="/assets/ico-clock.png" mode="aspectFit" />
                <text class="info-label">出发时间</text>
                <text class="info-value">{{trip.depart_time}}</text>
            </view>
            <view class="info-row">
                <image class="ico" src="/assets/ico-clock.png" mode="aspectFit" />
                <text class="info-label">返程时间</text>
                <text class="info-value">{{trip.return_time}}</text>
            </view>
            <view class="info-row">
                <image class="ico" src="/assets/ico-pin.png" mode="aspectFit" />
                <text class="info-label">出发地点</text>
                <text class="info-value">{{trip.depart_place}}</text>
            </view>
            <view class="info-row">
                <image class="ico" src="/assets/ico-pin.png" mode="aspectFit" />
                <text class="info-label">集合地点</text>
                <text class="info-value">{{trip.gather_place}}</text>
            </view>
            <view class="info-row">
                <image class="ico" src="/assets/ico-car.png" mode="aspectFit" />
                <text class="info-label">出行方式</text>
                <text class="info-value">{{trip.transport}}</text>
            </view>
            <view class="info-row">
                <image class="ico" src="/assets/ico-calendar.png" mode="aspectFit" />
                <text class="info-label">报名截止</text>
                <text class="info-value">{{trip.deadlineText}}</text>
            </view>
            <view class="divider"></view>
            <view class="info-row">
                <text class="info-label">费用说明</text>
                <text class="info-value">{{trip.feeNoteText}}</text>
            </view>
            <view class="info-row">
                <text class="info-label">行程安排</text>
                <text class="info-value">{{trip.itineraryText}}</text>
            </view>
            <view class="card-foot">
                <text class="muted">{{trip.ownerText}} 发布</text>
            </view>
        </view>

        <block wx:if="{{isAdmin}}">
        <view class="section">
            <text class="section-title"><text class="section-mark"></text>收款与支付（管理员）</text>
        </view>
        <view class="card">
            <view class="row between">
                <text class="info-label">收款方式</text>
                <text class="chip {{payment.degraded ? 'chip-warn' : 'chip-ok'}}">{{payment.methodText}}</text>
            </view>
            <view class="info-row">
                <text class="info-label">收款人</text>
                <text class="info-value">{{payment.payeeName}}</text>
            </view>
            <view class="info-row">
                <text class="info-label">收款账号</text>
                <text class="info-value">{{payment.payeeAccount}}</text>
            </view>
            <view class="info-row">
                <text class="info-label">收款联系</text>
                <text class="info-value">{{payment.contact}}</text>
            </view>
            <view class="info-row">
                <text class="info-label">付款说明</text>
                <text class="info-value">{{payment.noteText}}</text>
            </view>
            <view class="card-desc" wx:if="{{payment.degraded}}">在线支付尚未接入，本活动订单按线下收款登记；管理员确认收款后报名生效。</view>
            <view class="card-desc" wx:if="{{!payment.degraded && !payment.ready}}">当前为线下收款，管理员确认后订单状态会实时更新。</view>
            <view class="btn-row">
                <button class="btn btn-plain btn-sm" bindtap="onCopyAccount">复制收款账号</button>
                <button class="btn btn-ghost btn-sm" bindtap="onOpenPayment">支付接入说明</button>
            </view>
        </view>
        </block>

        <block wx:if="{{isAdmin}}">
            <view class="section">
                <text class="section-title"><text class="section-mark"></text>活动管理（管理员）</text>
            </view>
            <view class="card">
                <text class="card-desc">编辑活动与价格档位、调整收款方式、标记官方活动或删除活动。管理员同样可以为自己报名，订单会计入本活动名单。</text>
                <view class="btn-row btn-row-wrap">
                    <button class="btn btn-ghost btn-sm" bindtap="onEdit">编辑</button>
                    <button class="btn btn-plain btn-sm" bindtap="onToggleOfficial">{{trip.is_official ? '取消官方' : '设为官方'}}</button>
                </view>
                <view class="mt-16">
                    <button class="btn btn-danger" bindtap="onDelete">删除活动</button>
                </view>
            </view>

            <view class="section">
                <text class="section-title"><text class="section-mark"></text>本活动报名名单与导出（{{rosterCounts.orders}} 单 · {{rosterCounts.people}} 人）</text>
            </view>
            <view class="card">
                <text class="card-desc">点击报名人或拼团人姓名可查看完整资料，不再直接展开。导出的 Excel 只含本活动，含「参团人员名单」「活动汇总」「导出说明」三个工作表，身份证号完整显示，可直接用于保险名单；正式会员看不到其他报名人的信息。</text>
                <view class="chip-row">
                    <text class="chip chip-ok">已支付 {{rosterCounts.paid}} 单</text>
                    <text class="chip chip-muted">订单金额 ¥{{rosterCounts.totalAmount}}</text>
                </view>
                <view class="btn-row btn-row-wrap">
                    <button class="btn btn-primary btn-sm" loading="{{exporting}}" disabled="{{exporting}}" bindtap="onExportRoster">导出本活动名单</button>
                    <button class="btn btn-ghost btn-sm" disabled="{{exporting}}" bindtap="onShareRoster">发送名单到微信</button>
                    <button class="btn btn-plain btn-sm" bindtap="onCopyRoster">复制名单</button>
                </view>
            </view>

            <view class="card" wx:if="{{orders.length === 0}}">
                <text class="muted">本活动暂时还没有人报名</text>
            </view>
            <view class="card" wx:for="{{people}}" wx:key="key">
                <view class="person-row">
                    <view class="person-row-main">
                        <text class="person-name" data-key="{{item.key}}" bindtap="onOpenPerson">{{item.name}}</text>
                        <text class="person-row-sub">{{item.roleKindText}}<block wx:if="{{item.subText}}"> · {{item.subText}}</block></text>
                    </view>
                    <text class="chip {{item.statusTone}}">{{item.statusText}}</text>
                </view>
                <view class="btn-row btn-row-wrap" wx:if="{{item.orderId}}">
                    <button class="btn btn-primary btn-sm" wx:if="{{!item.isPaid}}" data-id="{{item.orderId}}" bindtap="onConfirmPaid">确认收款</button>
                    <button class="btn btn-plain btn-sm" wx:if="{{item.isPaid}}" data-id="{{item.orderId}}" bindtap="onRevokePaid">撤销收款</button>
                </view>
            </view>
        </block>

        <view class="card notice-card" wx:if="{{!canAct}}">
            <text class="strong">访客浏览 · 报名需审核通过</text>
            <text class="card-desc">{{actHint}} 活动详情与价格档位对所有访客公开，报名人员信息与订单不会对外展示。</text>
            <view class="btn-row">
                <button wx:if="{{guest}}" class="btn btn-primary btn-sm" bindtap="onLogin">登录 / 注册</button>
                <button wx:else class="btn btn-plain btn-sm" bindtap="onLogin">查看审核状态</button>
            </view>
        </view>

        <view class="section">
            <text class="section-title"><text class="section-mark"></text>选择价格类别</text>
        </view>
        <view wx:if="{{options.length === 0}}" class="card">
            <text class="muted">管理员还没有设置价格类别</text>
        </view>
        <view class="option-item {{selectedId === item.id ? 'option-on' : ''}}" wx:for="{{options}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectOption">
            <view class="option-dot {{selectedId === item.id ? 'option-dot-on' : ''}}"></view>
            <view class="option-main">
                <text class="option-name">{{item.name}}</text>
                <text class="option-note">{{item.noteText}}</text>
            </view>
            <text class="price">¥{{item.priceText}}</text>
        </view>

        <block wx:if="{{canAct}}">
        <view class="card mt-24" wx:if="{{trip.isOpen}}">
            <text class="section-title"><text class="section-mark"></text>填写报名信息</text>
            <text class="card-desc">实名资料已自动带入，可直接提交；如需修改，点「调用我的资料」重新带出，或到会员资料页更新。管理员也可以为自己报名，订单会计入本活动名单。</text>
            <view class="btn-row btn-row-wrap">
                <button class="btn btn-primary btn-sm" bindtap="onUseProfile">调用我的资料</button>
                <button class="btn btn-plain btn-sm" bindtap="onEditProfile">完善会员资料</button>
            </view>
            <text class="form-hint">{{profileHint}}</text>
            <view class="form-item">
                <text class="form-label">报名份数</text>
                <input class="form-input" type="number" value="{{quantity}}" bindinput="onQuantityInput" placeholder="1" />
            </view>
            <view class="form-item">
                <text class="form-label">姓名 <text class="form-required">*</text></text>
                <input class="form-input" value="{{realName}}" bindinput="onRealNameInput" placeholder="与证件一致的真实姓名" />
            </view>
            <view class="form-item">
                <text class="form-label">身份证号</text>
                <input class="form-input" value="{{idCardNo}}" bindinput="onIdCardInput" placeholder="18 位，用于保险名单" maxlength="18" />
            </view>
            <view class="form-item">
                <text class="form-label">手机号 <text class="form-required">*</text></text>
                <input class="form-input" type="number" value="{{phone}}" bindinput="onPhoneInput" placeholder="活动联络用 11 位手机号" maxlength="11" />
            </view>
            <view class="form-item">
                <text class="form-label">性别 <text class="form-required">*</text></text>
                <picker mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" bindchange="onGenderChange">
                    <view class="form-picker">{{genderLabels[genderIndex]}}<text class="muted">›</text></view>
                </picker>
            </view>
            <view class="form-item">
                <text class="form-label">备注</text>
                <input class="form-input" value="{{note}}" bindinput="onNoteInput" placeholder="房型 / 装备 / 其他需求" />
            </view>
            <view class="row between mt-16">
                <text class="muted">合计金额<block wx:if="{{isAdmin}}">（{{payment.channelText}}）</block></text>
                <text class="price">¥{{totalText}}</text>
            </view>
            <text class="form-hint">提交后请联系俱乐部管理员完成付款确认。</text>
        </view>

        <view class="section">
            <text class="section-title"><text class="section-mark"></text>我的订单</text>
        </view>
        <view class="card" wx:if="{{myOrders.length === 0}}">
            <text class="muted">你还没有报名这次活动</text>
        </view>
        <view class="card" wx:for="{{myOrders}}" wx:key="id">
            <view class="row between">
                <text class="strong">{{item.optionText}}</text>
                <text class="price-small">¥{{item.amountText}}</text>
            </view>
            <text class="card-desc">{{item.quantity}} 份 · {{item.contactText}} · {{item.noteText}}</text>
            <view class="chip-row">
                <text class="chip {{item.paymentTone}}">{{item.paymentStatusText}}</text>
                <text class="chip chip-muted" wx:if="{{isAdmin}}">{{item.paymentChannelText}}</text>
            </view>
            <text class="card-desc">业务单号：{{item.outTradeNoText}}</text>
            <text class="card-desc">付款信息：{{item.paymentNoteText}}</text>
            <text class="card-desc">{{item.paymentHint}}</text>
            <view class="btn-row" wx:if="{{!item.isPaid}}">
                <button class="btn btn-plain btn-sm" data-id="{{item.id}}" bindtap="onSubmitPaymentNote">提交付款信息</button>
                <button class="btn btn-danger btn-sm" data-id="{{item.id}}" bindtap="onCancelOrder">取消订单</button>
            </view>
        </view>
        </block>
    </view>

    <view class="footer-bar" wx:if="{{!loading && !error}}">
        <button class="btn btn-primary" wx:if="{{!canAct}}" bindtap="onLogin">{{guest ? '登录 / 注册后报名' : '审核通过后可报名'}}</button>
        <button class="btn btn-primary" wx:elif="{{trip.isOpen}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交报名并生成订单</button>
        <button class="btn btn-neutral" wx:else>报名已结束</button>
    </view>

    <view class="person-mask" wx:if="{{detailPerson}}" bindtap="onClosePerson"></view>
    <view class="person-panel" wx:if="{{detailPerson}}">
        <view class="person-panel-head">
            <text class="person-panel-title">{{detailPerson.title}}</text>
            <text class="person-panel-close" bindtap="onClosePerson">✕</text>
        </view>
        <text class="person-panel-hint">{{detailPerson.hint}}</text>
        <view class="person-panel-body">
            <view class="detail-line" wx:for="{{detailPerson.lines}}" wx:key="key">
                <text class="detail-key">{{item.key}}</text>
                <text class="detail-value" style="color:{{item.color}}">{{item.value}}</text>
            </view>
        </view>
        <button class="btn btn-primary" bindtap="onClosePerson">关闭</button>
    </view>
    </block>
</view>
