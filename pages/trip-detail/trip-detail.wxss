/* 报名前的滑雪活动风险告知书：条款可滚动，必须勾选后才允许确认报名。 */
.risk-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 90;
    background: rgba(24, 45, 62, 0.55);
}

.risk-panel {
    position: fixed;
    left: 36rpx;
    right: 36rpx;
    top: 50%;
    transform: translateY(-50%);
    z-index: 91;
    max-height: 86vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: 32rpx 30rpx 28rpx;
    border-radius: 28rpx;
    background: #F7FBFD;
    box-shadow: 0 18rpx 50rpx rgba(60, 88, 110, 0.24);
}

.risk-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.risk-title {
    font-size: 34rpx;
    font-weight: 700;
    color: #274B68;
}

.risk-close {
    padding: 8rpx 16rpx;
    font-size: 34rpx;
    color: #7A93A8;
}

.risk-body {
    height: 50vh;
    margin-bottom: 12rpx;
}

.risk-line {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 18rpx;
}

.risk-index {
    flex: none;
    min-width: 40rpx;
    font-size: 28rpx;
    font-weight: 700;
    line-height: 1.65;
    color: #3D78A8;
}

.risk-text {
    flex: 1;
    font-size: 28rpx;
    line-height: 1.65;
    color: #3B5468;
}

.risk-agree {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 18rpx 4rpx 24rpx;
    border-top: 2rpx solid #DCEBF7;
}

.risk-checkbox {
    flex: none;
    width: 38rpx;
    height: 38rpx;
    box-sizing: border-box;
    border: 2rpx solid #8FA8BC;
    border-radius: 8rpx;
    background: #FFFFFF;
    text-align: center;
    line-height: 34rpx;
    font-size: 28rpx;
    color: #FFFFFF;
}

.risk-checkbox-on {
    border-color: #3D78A8;
    background: #3D78A8;
}

.risk-agree-text {
    margin-left: 16rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #274B68;
}
