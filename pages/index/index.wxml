<view class="page">
    <access-gate wx:if="{{gate}}" gate="{{gate}}" bind:refresh="onRefresh" />
    <block wx:else>
    <view class="brand-bar">
        <image class="brand-bar-mark" src="/assets/brand-mark.png" mode="aspectFit" />
        <view class="brand-bar-text">
            <text class="brand-bar-name">雪狸 · ARCTIC CIVET</text>
            <text class="brand-bar-slogan">滑雪俱乐部 · 一起上雪</text>
        </view>
    </view>

    <view class="hero hero-photo">
        <image class="hero-photo-bg" src="/assets/module-buddy.jpg" mode="aspectFill" />
        <view class="hero-photo-mask"></view>
        <text class="hero-kicker">SKI CLUB · 一起上雪</text>
        <text class="hero-title">滑雪搭子</text>
        <text class="hero-sub">发布拼车与拼搭子，约好时间一起出发</text>
    </view>

    <view class="card notice-card" wx:if="{{!canView}}">
        <view class="row between">
            <text class="strong">访客浏览 · 内容概览</text>
        </view>
        <text class="card-desc">所有模块已开放浏览，可以先看看大家发布了什么；{{actHint}}</text>
        <view class="btn-row">
            <button wx:if="{{guest}}" class="btn btn-primary btn-sm" bindtap="onLogin">登录 / 注册</button>
            <button wx:else class="btn btn-plain btn-sm" bindtap="onLogin">查看审核状态</button>
        </view>
    </view>

    <view class="filters">
        <view class="filter-item {{filter === 'all' ? 'filter-on' : ''}}" data-value="all" bindtap="onFilter">全部</view>
        <view class="filter-item {{filter === 'carpool' ? 'filter-on' : ''}}" data-value="carpool" bindtap="onFilter">拼车</view>
        <view class="filter-item {{filter === 'partner' ? 'filter-on' : ''}}" data-value="partner" bindtap="onFilter">拼搭子</view>
    </view>

    <view wx:if="{{loading}}" class="state">正在加载云端数据…</view>
    <view wx:elif="{{error}}" class="state">
        <text class="state-title">加载失败</text>
        <text>{{error}}</text>
        <view class="state-action" bindtap="load">重新加载</view>
    </view>
    <view wx:elif="{{list.length === 0}}" class="state">
        <text class="state-title">还没有人发布</text>
        <text>点右下角按钮，成为第一个发起的人</text>
    </view>

    <view wx:else>
        <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
            <view class="card-head">
                <text class="card-title">{{item.title}}</text>
                <text class="tag-official" wx:if="{{item.isOpen}}">报名中</text>
                <text class="chip chip-muted" wx:else>{{item.statusText}}</text>
            </view>
            <view class="chip-row">
                <text class="chip">{{item.kindText}}</text>
                <text class="chip chip-muted">{{item.transport}}</text>
                <text class="chip chip-muted">余 {{item.seats}} 位</text>
            </view>
            <view class="info-grid">
                <view class="info-cell">
                    <text class="info-cell-label">出发</text>
                    <text class="info-cell-value">{{item.depart_time}}</text>
                </view>
                <view class="info-cell">
                    <text class="info-cell-label">返程</text>
                    <text class="info-cell-value">{{item.return_time}}</text>
                </view>
                <view class="info-cell">
                    <text class="info-cell-label">出发地</text>
                    <text class="info-cell-value">{{item.depart_place}}</text>
                </view>
                <view class="info-cell">
                    <text class="info-cell-label">目的地</text>
                    <text class="info-cell-value">{{item.resortText}}</text>
                </view>
            </view>
            <view class="card-foot">
                <text class="muted">{{item.ownerText}} · {{item.feeShort}}</text>
                <image class="ico" src="/assets/ico-arrow.png" mode="aspectFit" />
            </view>
        </view>
    </view>

    <view class="fab" bindtap="onPublish">
        <text class="fab-plus">＋</text>
        <text>发布信息</text>
    </view>
    </block>
</view>
