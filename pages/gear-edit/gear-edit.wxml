<view class="page page-no-tab">
    <view class="review-tip">提交后需管理员审核，通过才会对外展示；修改内容会重新进入审核。</view>
    <view class="hero hero-plain">
        <text class="hero-kicker">发布 · 编辑</text>
        <text class="hero-title">{{isEdit ? '编辑装备信息' : '发布雪具'}}</text>
        <text class="hero-sub">图片上传至云端，重新打开依然可见</text>
    </view>

    <view class="form-card">
        <text class="form-title">装备图片</text>
        <view class="image-grid">
            <view class="image-box" wx:for="{{images}}" wx:key="key">
                <image src="{{item.url}}" mode="aspectFill" />
                <view class="image-del" data-index="{{index}}" bindtap="onRemoveImage">×</view>
            </view>
            <view class="image-add" wx:if="{{images.length < 6}}" bindtap="onChooseImage">
                <text class="image-add-plus">＋</text>
                <text>添加图片</text>
            </view>
        </view>
        <text class="form-hint">最多 6 张，支持相册选取或拍照。图片保存在云端存储。</text>
    </view>

    <view class="form-card">
        <text class="form-title">商品信息</text>
        <view class="form-item">
            <text class="form-label">标题 <text class="form-required">*</text></text>
            <input class="form-input" value="{{title}}" bindinput="onTitleInput" placeholder="例如：24-25 款 Single 单板 154cm" />
        </view>
        <view class="form-item">
            <text class="form-label">装备分类</text>
            <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
                <view class="form-picker">{{categoryText}}<text class="muted">›</text></view>
            </picker>
        </view>
        <view class="form-item">
            <text class="form-label">成色</text>
            <picker mode="selector" range="{{conditionLabels}}" value="{{conditionIndex}}" bindchange="onConditionChange">
                <view class="form-picker">{{conditionText}}<text class="muted">›</text></view>
            </picker>
        </view>
        <view class="form-line">
            <view class="form-item">
                <text class="form-label">售价（元）<text class="form-required">*</text></text>
                <input class="form-input" type="digit" value="{{price}}" bindinput="onPriceInput" placeholder="0.00" />
            </view>
            <view class="form-item">
                <text class="form-label">原价（元）</text>
                <input class="form-input" type="digit" value="{{originalPrice}}" bindinput="onOriginalPriceInput" placeholder="选填" />
            </view>
        </view>
        <view class="form-item">
            <text class="form-label">发布状态</text>
            <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="onStatusChange">
                <view class="form-picker">{{statusText}}<text class="muted">›</text></view>
            </picker>
        </view>
    </view>

    <view class="form-card">
        <text class="form-title">描述与交易</text>
        <view class="form-item">
            <text class="form-label">装备描述</text>
            <textarea class="form-textarea" value="{{description}}" bindinput="onDescriptionInput" placeholder="使用次数、磨损情况、尺寸、是否含固定器等" />
        </view>
        <view class="form-item">
            <text class="form-label">交易地点</text>
            <input class="form-input" value="{{tradePlace}}" bindinput="onTradePlaceInput" placeholder="例如：北京朝阳 / 雪场当面交易" />
        </view>
        <view class="form-item">
            <text class="form-label">联系方式</text>
            <input class="form-input" value="{{contact}}" bindinput="onContactInput" placeholder="微信号 / 手机号" />
        </view>
    </view>

    <text class="form-error" wx:if="{{error}}">{{error}}</text>
    <button class="btn btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">{{isEdit ? '保存修改' : '立即发布'}}</button>
    <view class="mt-24" wx:if="{{isEdit}}">
        <button class="btn btn-danger" bindtap="onDelete">删除这件装备</button>
    </view>
</view>
