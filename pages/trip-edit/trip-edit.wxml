<view class="page page-no-tab">
    <access-gate wx:if="{{gate}}" gate="{{gate}}" bind:refresh="onRefresh" />
    <block wx:else>
    <view class="review-tip">管理员专属发布：活动与价格档位保存后立即对正式会员展示，无需二次审核。</view>
    <view class="hero hero-plain">
        <text class="hero-kicker">ADMIN · 发布 / 编辑</text>
        <text class="hero-title">{{isEdit ? '编辑出游活动' : '发布俱乐部参团'}}</text>
        <text class="hero-sub">行程、集合方式、价格类别与收款方式一次说清</text>
    </view>

    <view class="form-card">
        <text class="form-title">活动信息</text>
        <view class="form-item">
            <text class="form-label">活动标题 <text class="form-required">*</text></text>
            <input class="form-input" value="{{title}}" bindinput="onTitleInput" placeholder="例如：元旦崇礼三日滑雪团" />
        </view>
        <view class="form-item">
            <text class="form-label">目的雪场</text>
            <input class="form-input" value="{{resort}}" bindinput="onResortInput" placeholder="例如：太舞滑雪小镇" />
        </view>
        <view class="form-item">
            <text class="form-label">报名状态</text>
            <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="onStatusChange">
                <view class="form-picker">{{statusText}}<text class="muted">›</text></view>
            </picker>
        </view>
        <view class="form-item">
            <text class="form-label">俱乐部官方活动</text>
            <switch checked="{{isOfficial}}" color="#3D78A8" bindchange="onOfficialChange" />
            <text class="form-hint">官方活动会在列表里优先标识</text>
        </view>
    </view>

    <view class="form-card">
        <text class="form-title">时间 · 地点 · 出行</text>
        <view class="form-line">
            <view class="form-item">
                <text class="form-label">出发日期 <text class="form-required">*</text></text>
                <picker mode="date" value="{{departDate}}" bindchange="onDepartDate">
                    <view class="form-picker">{{departDate}}<text class="muted">›</text></view>
                </picker>
            </view>
            <view class="form-item">
                <text class="form-label">出发时间</text>
                <picker mode="time" value="{{departTime}}" bindchange="onDepartTime">
                    <view class="form-picker">{{departTime}}<text class="muted">›</text></view>
                </picker>
            </view>
        </view>
        <view class="form-line">
            <view class="form-item">
                <text class="form-label">返程日期 <text class="form-required">*</text></text>
                <picker mode="date" value="{{returnDate}}" bindchange="onReturnDate">
                    <view class="form-picker">{{returnDate}}<text class="muted">›</text></view>
                </picker>
            </view>
            <view class="form-item">
                <text class="form-label">返程时间</text>
                <picker mode="time" value="{{returnTime}}" bindchange="onReturnTime">
                    <view class="form-picker">{{returnTime}}<text class="muted">›</text></view>
                </picker>
            </view>
        </view>
        <view class="form-item">
            <text class="form-label">出发地点 <text class="form-required">*</text></text>
            <input class="form-input" value="{{departPlace}}" bindinput="onDepartPlaceInput" placeholder="例如：北京国贸" />
        </view>
        <view class="form-item">
            <text class="form-label">集合地点 <text class="form-required">*</text></text>
            <input class="form-input" value="{{gatherPlace}}" bindinput="onGatherPlaceInput" placeholder="例如：国贸地铁站 F 口大巴旁" />
        </view>
        <view class="form-item">
            <text class="form-label">出行方式</text>
            <picker mode="selector" range="{{transports}}" value="{{transportIndex}}" bindchange="onTransportChange">
                <view class="form-picker">{{transportText}}<text class="muted">›</text></view>
            </picker>
        </view>
        <view class="form-line">
            <view class="form-item">
                <text class="form-label">总名额</text>
                <input class="form-input" type="number" value="{{capacity}}" bindinput="onCapacityInput" placeholder="20" />
            </view>
            <view class="form-item">
                <text class="form-label">报名截止</text>
                <picker mode="date" value="{{deadline}}" bindchange="onDeadline">
                    <view class="form-picker">{{deadline}}<text class="muted">›</text></view>
                </picker>
            </view>
        </view>
    </view>

    <view class="form-card">
        <text class="form-title">费用与行程</text>
        <view class="form-item">
            <text class="form-label">费用说明</text>
            <textarea class="form-textarea" value="{{feeNote}}" bindinput="onFeeNoteInput" placeholder="包含 / 不包含项目，退改规则等" />
        </view>
        <view class="form-item">
            <text class="form-label">行程安排</text>
            <textarea class="form-textarea" value="{{itinerary}}" bindinput="onItineraryInput" placeholder="D1 集合出发… D2 全天滑雪… D3 返程" />
        </view>
    </view>

    <view class="form-card">
        <text class="form-title">收款设置</text>
        <view class="form-item">
            <text class="form-label">收款方式</text>
            <picker mode="selector" range="{{methodLabels}}" value="{{methodIndex}}" bindchange="onMethodChange">
                <view class="form-picker">{{methodText}}<text class="muted">›</text></view>
            </picker>
            <text class="form-hint" wx:if="{{!gatewayReady}}">在线支付当前为「{{gatewayText}}」，选择后订单会先按线下收款登记，接入完成后自动切换。</text>
        </view>
        <view class="form-item">
            <text class="form-label">本活动收款说明</text>
            <textarea class="form-textarea" value="{{paymentNote}}" bindinput="onPaymentNoteInput" placeholder="付款账户、付款时限、备注格式等" />
        </view>
        <view class="form-item" bindtap="onGoPaymentSettings">
            <text class="form-label">俱乐部收款配置与支付接入</text>
            <view class="form-picker">查看接入状态与维护收款信息<text class="muted">›</text></view>
        </view>
    </view>

    <view class="section">
        <text class="section-title"><text class="section-mark"></text>价格类别</text>
        <text class="section-more" bindtap="onAddOption">＋ 添加</text>
    </view>
    <view class="card" wx:for="{{options}}" wx:key="key">
        <view class="row between">
            <text class="strong">类别 {{index + 1}}</text>
            <text class="section-more" data-index="{{index}}" bindtap="onRemoveOption">删除</text>
        </view>
        <view class="form-item">
            <text class="form-label">名称 <text class="form-required">*</text></text>
            <input class="form-input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onOptionInput" placeholder="成人价 / 儿童价 / 会员价" />
        </view>
        <view class="form-line">
            <view class="form-item">
                <text class="form-label">价格（元）<text class="form-required">*</text></text>
                <input class="form-input" type="digit" value="{{item.price}}" data-index="{{index}}" data-field="price" bindinput="onOptionInput" placeholder="0.00" />
            </view>
            <view class="form-item">
                <text class="form-label">名额上限</text>
                <input class="form-input" type="number" value="{{item.capacity}}" data-index="{{index}}" data-field="capacity" bindinput="onOptionInput" placeholder="0 为不限" />
            </view>
        </view>
        <view class="form-item">
            <text class="form-label">说明</text>
            <input class="form-input" value="{{item.note}}" data-index="{{index}}" data-field="note" bindinput="onOptionInput" placeholder="含雪票 / 含住宿 / 自备装备" />
        </view>
    </view>
    <view class="card" wx:if="{{options.length === 0}}">
        <text class="muted">还没有价格类别，点右上角「＋ 添加」新增</text>
    </view>

    <text class="form-error" wx:if="{{error}}">{{error}}</text>
    <button class="btn btn-primary mt-24" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">{{isEdit ? '保存修改' : '立即发布'}}</button>
    <view class="mt-24" wx:if="{{isEdit}}">
        <button class="btn btn-danger" bindtap="onDelete">删除活动</button>
    </view>
    </block>
</view>
