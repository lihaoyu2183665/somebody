# 服务端口
PORT=3001

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ski
DB_PASSWORD=ski_secret_change_me
DB_NAME=ski_club

# 网页管理后台账号密码
ADMIN_USER=admin
ADMIN_PASSWORD=skiclub2026

# 对外基础地址（用于图片 URL；Docker 部署填域名或 IP）
PUBLIC_BASE_URL=http://localhost:3001

# 图片上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# 微信登录（留空则进入兼容模式，code 以 wx: 开头直接作为 openid）
WX_APPID=
WX_SECRET=
